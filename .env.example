# Same Google Cloud project / same API key as go-ride-driver-app (stored there as MAP_API_KEY).
# Restricted by Android package name + debug-keystore SHA-1 — see plan 01-08.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# 10.0.2.2 is the Android *emulator's* alias for the host machine.
# On a physical device use the host LAN IP (http://192.168.x.x:8080/api/v1)
# or run `adb reverse tcp:8080 tcp:8080` and use http://localhost:8080/api/v1.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/api/v1
# cab-request-handler (go-ride-kafka-consumers) — a DIFFERENT service on a DIFFERENT port
# than go-ride-backend above. Its HTTP_ADDR default is :8082 and its routes live under
# /api/v1/cab (POST /fare-estimate, POST /request-cab). Same physical-device LAN-IP
# convention as EXPO_PUBLIC_API_BASE_URL — see .planning/phases/01-foundation-auth/01-08-SUMMARY.md.
EXPO_PUBLIC_CAB_API_BASE_URL=http://10.0.2.2:8082/api/v1/cab
